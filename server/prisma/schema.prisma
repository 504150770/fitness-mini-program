generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  openid    String   @unique
  unionid   String?
  nickname  String?
  avatarUrl String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profile     UserProfile?
  bodyRecords BodyRecord[]
}

model UserProfile {
  userId    String    @id
  user      User      @relation(fields: [userId], references: [id])
  gender    String?
  birthDate DateTime?
  heightCm  Float?
  goal      String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model BodyRecord {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  recordedAt DateTime @default(now())
  weightKg   Float
  bodyFatPct Float?
  photoUrl   String?
  note       String?
  createdAt  DateTime @default(now())

  @@index([userId, recordedAt])
}
