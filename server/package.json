{
    "name":  "fitness-app-server",
    "version":  "0.1.0",
    "private":  true,
    "scripts":  {
                    "dev":  "tsx watch src/app.ts",
                    "build":  "tsc",
                    "start":  "node dist/app.js",
                    "prisma:generate":  "prisma generate",
                    "db:generate":  "prisma generate",
                    "db:diff":  "prisma migrate diff --from-schema-datasource prisma/schema.prisma --to-schema-datamodel prisma/schema.prisma --script",
                    "db:apply":  "prisma db execute --file prisma/migration.sql --schema prisma/schema.prisma"
                },
    "dependencies":  {
                         "@prisma/client":  "^5.22.0",
                         "dotenv":  "^16.4.5",
                         "express":  "^4.21.2",
                         "jsonwebtoken":  "^9.0.2"
                     },
    "devDependencies":  {
                            "@types/express":  "^4.17.21",
                            "@types/jsonwebtoken":  "^9.0.6",
                            "@types/node":  "^22.9.0",
                            "prisma":  "^5.22.0",
                            "tsx":  "^4.19.2",
                            "typescript":  "^5.6.3"
                        }
}